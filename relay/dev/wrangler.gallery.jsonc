{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "astra-ui-gallery",
  "main": "gallery-worker.ts",
  "compatibility_date": "2026-10-14",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  "rules": [{"type":"Text","globs":["**/*.html","**/astra.css","**/setup.css","**/setup.js","**/PRIVACY.md","**/TERMS.md","**/LICENSE"],"fallthrough":true}],
  "vars": {
    "PUBLIC_ORIGIN": "http://127.0.0.1:8790",
    "DEPLOYMENT_MODE": "local",
    "PUBLISHER_COST_POLICY": "free-only",
    "CALLBACK_HOSTS": "chatgpt.com,api.openai.com",
    "MAX_TASKS_PER_OWNER": "64",
    "RETENTION_HOURS": "72",
    "GITHUB_CLIENT_ID": "synthetic-gallery-client",
    "GITHUB_CLIENT_SECRET": "synthetic-gallery-secret",
    "SESSION_SECRET": "synthetic-gallery-session-key-never-a-production-credential",
    "ENTRA_TENANT_ID": "11111111-1111-4111-8111-111111111111",
    "ENTRA_AUTHORITY": "https://designgallery.ciamlogin.com/11111111-1111-4111-8111-111111111111",
    "ENTRA_CLIENT_ID": "22222222-2222-4222-8222-222222222222",
    "ENTRA_CLIENT_SECRET": "synthetic-gallery-entra-secret"
  },
  "kv_namespaces": [{"binding":"OAUTH_KV"}],
  "durable_objects": {"bindings":[{"name":"OWNERS","class_name":"GalleryOwnerRelay"},{"name":"PAIRINGS","class_name":"WorkerPairing"}]},
  "migrations": [{"tag":"gallery-v1","new_sqlite_classes":["GalleryOwnerRelay","WorkerPairing"]}],
  "dev": {"ip":"127.0.0.1","port":8790,"local_protocol":"http"},
  "observability": {"enabled":false}
}
